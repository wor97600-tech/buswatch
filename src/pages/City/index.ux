<template>
  <div class="page">
    <div class="header">
      <div class="back-hit" onclick="goBack">
        <text class="back">‹</text>
      </div>
      <text class="title2" onclick="goBack">{{ headerTitle }}</text>
      <div class="header-spacer"></div>
    </div>

    <div class="row">
      <input
        class="input"
        id="citykw"
        type="text"
        placeholder="城市名或拼音"
        onchange="onCityQueryChange"
      />
      <div class="sbtn {{ citySearching ? 'busy' : '' }}" onclick="searchCities">
        <text class="sbtn-text">{{ citySearching ? '查找中…' : '搜索' }}</text>
      </div>
    </div>

    <text class="tip {{ citySearching ? 'busy' : '' }}" if="{{ cityHint }}">{{ cityHint }}</text>
    <div class="foot2">
      <div class="wide-btn" onclick="downloadCityCache">
        <text class="wide-text">{{ cityDownloading ? '正在下载…' : (cityCacheReady ? '重新下载城市缓存' : '下载城市缓存') }}</text>
      </div>
    </div>
    <text class="retry" if="{{ cityError }}" onclick="retryCityAction">{{ cityError }} · 点此重试</text>

    <list class="slist city-list" if="{{ cityList.length > 0 }}">
      <list-item
        class="city-item"
        type="city"
        tid="key"
        for="{{(index, item) in cityList}}"
        onclick="pickCity(item)"
      >
        <div class="item-inner">
          <text class="city-name {{ item.selected ? 'city-selected' : '' }}">{{ item.cityName }}</text>
          <text class="city-meta">{{ item.pinyin }}</text>
        </div>
      </list-item>
    </list>
  </div>
</template>

<script>
import pageLogic, { setBuiltInCities } from '../../common/page-logic'
import BUILTIN_CITIES from '../../common/builtin-cities'

setBuiltInCities(BUILTIN_CITIES)

export default pageLogic
</script>

<style>
@import "../../common/style.css";
